# Cloudflare Pages cache headers

# HTML pages — short cache, always revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Root
/
  Cache-Control: public, max-age=0, must-revalidate

# Assets — long cache (content-hashed or rarely change)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# AI briefs — medium cache
/ai_briefs/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Posts — medium cache
/posts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Fonts loaded via Google Fonts (external, already cached)
# CSS/JS in assets/ already covered above
